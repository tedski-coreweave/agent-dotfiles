{
  "lastChangelogVersion": "0.87.1",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:pi-parallel-sessions",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:pi-rewind",
    "npm:pi-devin-provider",
    "npm:pi-powerline"
  ],
  "powerline": true,
  "breadcrumb": "inner",
  "footer": true,
  "footer-mcp": true,
  "header": false,
  "header-info": false,
  "httpIdleTimeoutMs": 30000,
  "outputPad": 0,
  "warnings": {
